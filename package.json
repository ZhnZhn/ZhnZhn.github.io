{
  "name": "web-app-erc",
  "version": "0.18.0",
  "description": "Web app ERC (Economic RESTful Client)",
  "main": "index.js",
  "scripts": {
    "dev": "webpack serve --config webpack.dev.js",
    "dev:rspack": "rspack serve --config rspack.dev.js",
    "test:node": "rstest --config rstest.config.mjs --project node",
    "test:dom": "rstest --config rstest.config.mjs --project dom",
    "test:rstest": "npm run test:node && npm run test:dom",
    "transpile": "babel ./src --out-dir ./js --source-maps --ignore test.js",
    "transpile:all": "babel ./src --out-dir ./js --source-maps",
    "lint:one": "eslint -c eslint.config.js",
    "lint:biome": "npx @biomejs/biome lint ./src --colors=off",
    "lint:only": "npx @biomejs/biome lint ./src --only=useOptionalChain --colors=off",
    "css:min": "node ut/css-min.js",
    "build:dev:dll": "webpack --color --progress --config webpack.dev.dll.js",
    "build:dev:dll-jsx": "webpack --color --progress --config webpack.dev.dll-jsx.js",
    "build:dll": "webpack --color --progress --config webpack.dll.js",
    "build:dll-jsx": "webpack --color --progress --config webpack.dll-jsx.js",
    "build:rspack:prod": "rspack build --config rspack.prod.js",
    "stats": "npm run stats:json && npm run stats:report",
    "stats:json": "webpack --config webpack.dll-jsx.js --profile --json > stats.json",
    "stats:report": "webpack-bundle-analyzer stats.json --no-open --mode static"
  },
  "author": "Yevhenii Molodyi",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhnZhn/ZhnZhn.github.io.git"
  },
  "keywords": [
    "restful-client",
    "data-visualization",
    "chart-creation",
    "open-data",
    "opendata",
    "economic-indicators",
    "statistics-viewer",
    "macroeconomics",
    "stock-market",
    "cryptocurrency-prices"
  ],
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "big.js": "^6.2.2",
    "highcharts": "^9.1.2",
    "leaflet": "^1.3.4",
    "localforage": "^1.10.0",
    "raven-js": "^3.27.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@biomejs/biome": "^2.6.4",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@rspack/dev-server": "^2.2.2",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@rstest/core": "^0.12.5",
    "@swc/helpers": "^0.5.23",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "babel-loader": "^10.1.1",
    "clean-css": "^5.3.3",
    "eslint": "^9.39.5",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.3",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "^18.3.1",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^7.2.3"
  },
  "overrides": {
    "glob": "~14.0.3",
    "minimatch": "~11.0.3"
  }
}
